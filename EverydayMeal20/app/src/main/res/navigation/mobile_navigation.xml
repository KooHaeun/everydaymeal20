<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.everydaymeal.ui.home.HomeCalFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home_cal" />

    <fragment
        android:id="@+id/navigation_calendar"
        android:name="com.example.everydaymeal.ui.calendar.CalendarFragment"
        android:label="@string/calendar"
        tools:layout="@layout/fragment_calendar" />

    <fragment
        android:id="@+id/navigation_graph"
        android:name="com.example.everydaymeal.ui.graph.GraphFragment"
        android:label="@string/title_graph"
        tools:layout="@layout/fragment_graph" />
    <fragment
        android:id="@+id/navigation_setting"
        android:name="com.example.everydaymeal.ui.setting.SettingFragment"
        android:label="@string/title_setting"
        tools:layout="@layout/fragment_setting" />
</navigation>